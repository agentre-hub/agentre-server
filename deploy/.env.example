# 抄成 deploy/.env（compose 的项目目录是本文件所在目录，放仓库根不会被读到）。
# 每项都有缺省值，整份注释掉也能起。

# 浏览器和设备真正访问到的地址；通行密钥的 rp_id / origins 跟着它推导
#SERVER_PUBLIC_URL=http://localhost:8443
#SERVER_PORT=8443

#SERVER_IMAGE=ghcr.io/agentre-hub/agentre-server:latest   # 或 :nightly
#SERVER_PULL_POLICY=always                                # build=用本仓库源码现打

# 内置 mysql：这几项同时喂给 mysql 和 server
#DB_NAME=server
#DB_USER=server
#DB_PASSWORD=server
#DB_ROOT_PASSWORD=root
# 连外部库：整条覆盖，上面几项对 server 不再起作用
#DB_DSN=user:pass@tcp(db.example.com:3306)/agentre?charset=utf8mb4&parseTime=True&loc=Local&interpolateParams=true

# 内置 redis：口令同时喂给 --requirepass 和 server
#REDIS_PASSWORD=
#REDIS_ADDR=redis:6379   # 指向外部 redis 时内置那个服务就不用管了

# 1=首次启动时没有私钥就自己生成一把。别删 deploy_keys 卷；多副本必须设 0 并自备密钥
#JWT_AUTO_GENERATE=1

# 回调地址填 $SERVER_PUBLIC_URL/v1/auth/oauth/github/callback
#GH_CLIENT_ID=
#GH_CLIENT_SECRET=

# build
/bin/
/coverage.out
/coverage.html
/runtime/

# frontend
/frontend/node_modules/
/frontend/dist/
/internal/web/dist/
*.tsbuildinfo

# data
/data/
/.env
/config.yaml
/configs/config.yaml
/configs/config.e2e.yaml

# 一次性本地验证脚本与证据（见 docs/verification.md）；不提交，也不进 CI。
# 保留目录本身：playwright.scratch.config.ts 的 testDir 指向它，
# 目录不存在时 `pnpm scratch` 直接报错。
/e2e/scratch/*
!/e2e/scratch/.gitkeep
# drive 的浏览器状态、serve 交接件，以及本轮 key/log/seed/cleanup/trace。
# 这些文件含一次性 Cookie、CSRF、DSN 或失败证据，只能留在本机运行目录。
/e2e/.drive/
/e2e/runtime/
/e2e/node_modules/
/e2e/test-results/
/e2e/playwright-report/
/e2e/playwright-web-report/
/e2e/playwright-dual-report/

# editor / tooling
.idea/
.vscode/
*.swp
.DS_Store
/.omc/
/.opskat/

# local round workspaces (dev-kit worktrees)
/.worktrees/
# dev-kit 的本轮工作区状态（plans / artifacts）。不写斜杠：worktree 里它是符号链接，
# 带斜杠的规则匹配不到符号链接。
/.dev-kit
